# Generated by PipeWireAORTC.SessionInstall. Reinstall to change this unit.
[Unit]
Description=Headless PipeWireAO RTC session %i
@DIRECT_DEPENDENCIES@

[Service]
Type=notify
NotifyAccess=main
@ACTIVATION_ENVIRONMENT@
Environment=PIPEWIREAORTC_SYSTEMD_UNIT=%n
ExecStart=@RTC_INSTALLED_COMMAND@ -c @RTC_CONFIGURATION@
ExecStop=@LAUNCHER@ stop --unit %n --runtime-root %t/pipewireao-session-%i --direct
RuntimeDirectory=pipewireao-session-%i
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
UMask=0077
LimitRTPRIO=95
LimitMEMLOCK=4294967296
CPUAffinity=@CPUS@
KillMode=control-group
KillSignal=SIGINT
TimeoutStartSec=300
TimeoutStopSec=300
Restart=no

[Install]
WantedBy=default.target
