context.properties = {
    log.level = 0
    library.use-fallback = false
    mem.mlock-all = false
    context.data-loops = [
        { loop.name = analysis-data-loop thread.name = analysis-data
          loop.class = [ data.rt ] loop.idle = eventfd loop.rt-prio = 0 }
    ]
}
context.spa-libs = { support.* = support/libspa-support }
context.modules = [
    { name = libpipewire-module-protocol-native }
    { name = libpipewire-module-client-node }
]
