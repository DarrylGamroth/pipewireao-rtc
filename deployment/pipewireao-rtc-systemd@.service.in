[Unit]
Description=PipeWireAO RTC coordinator with separate owner services %i

[Service]
Type=notify
NotifyAccess=main
ExecStart=@LAUNCHER@ run --pipewire-prefix @PIPEWIRE_PREFIX@ --deployment %h/.config/pipewireao-rtc/%i/deployment.conf@FITS_ARGUMENT@ --runtime %t/pipewireao-rtc-systemd-%i --process-supervisor systemd --supervisor-unit %n
ExecStopPost=@LAUNCHER@ cleanup-systemd-owners --invocation ${INVOCATION_ID}
RuntimeDirectory=pipewireao-rtc-systemd-%i
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
UMask=0077
LimitRTPRIO=95
LimitMEMLOCK=4294967296
CPUAffinity=@CPUS@
KillMode=mixed
KillSignal=SIGINT
TimeoutStartSec=600
TimeoutStopSec=300
Restart=no

[Install]
WantedBy=default.target
