{
    remote.name = "@REMOTE_NAME@"
    node.name = "@NODE_NAME@"
    object.linger = false
    pipewireao.run-control = true
    pipewireao.reset-control = true
    filter.graph = {
        nodes = [
            {
                type = ndarray
                name = primary
                plugin = "@FGN_BUNDLE@"
                label = leaky-integrator-f32
                config = {
                    extent = 2
                    initial_state = 0.0
                    input_schema = "org.pipewireao.rtc.latest-hold.primary/1"
                    output_schema = "org.pipewireao.rtc.latest-hold.primary/1"
                    rate = [ 1000 1 ]
                }
                props = { gain = 1.0 pole = 0.0 }
            }
            {
                type = ndarray
                name = held
                plugin = "@FGN_BUNDLE@"
                label = leaky-integrator-f32
                config = {
                    extent = 2
                    initial_state = 0.0
                    input_schema = "org.pipewireao.rtc.latest-hold.slow/1"
                    output_schema = "org.pipewireao.rtc.latest-hold.slow/1"
                    rate = [ 1000 1 ]
                }
                props = { gain = 1.0 pole = 0.0 }
            }
        ]
        inputs = [ "primary:input" "held:input" ]
        outputs = [ "primary:output" ]
    }
}
